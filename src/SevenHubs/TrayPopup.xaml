<Window x:Class="SevenHubs.TrayPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SevenHubs.Converters"
        Title="7 HUBs"
        Width="372"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Deactivated="Window_Deactivated">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:BatteryBrushConverter x:Key="BatteryBrush" />
        <conv:ConnectionBrushConverter x:Key="ConnectionBrush" />
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#A78BFA" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="8,4" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#12151D"
            BorderBrush="#2A3142"
            BorderThickness="1"
            CornerRadius="18"
            Padding="18"
            Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="9" Opacity="0.6" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <Grid>
                <StackPanel>
                    <TextBlock Text="已连接设备" Foreground="#F2F4F8" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Summary}" Foreground="#8B93A7" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>
                <Button Content="打开主界面" Style="{StaticResource LinkButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Click="OpenMain_Click"
                        Visibility="Collapsed" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Devices}" Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#181C26" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="10" Background="#222838" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Glyph}" FontSize="17" Foreground="#E8EBF2"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Foreground="#EDF0F6" FontSize="12.5" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <Ellipse Width="6" Height="6" Fill="{Binding Connection, Converter={StaticResource ConnectionBrush}}"
                                                 VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBlock Text="{Binding ConnectionText}" Foreground="#8B93A7" FontSize="10.5" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="54">
                                    <TextBlock Text="{Binding BatteryText}" Foreground="{Binding Battery, Converter={StaticResource BatteryBrush}}"
                                               FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" />
                                    <ProgressBar Value="{Binding Battery, TargetNullValue=0}" Maximum="100"
                                                 Visibility="{Binding HasBattery, Converter={StaticResource BoolToVis}}"
                                                 Height="5" Margin="0,4,0,0" Background="#2A3040"
                                                 Foreground="{Binding Battery, Converter={StaticResource BatteryBrush}}"
                                                 BorderThickness="0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Background="#181C26" CornerRadius="12" Padding="14" Margin="0,2,0,8"
                    Visibility="{Binding HasNoDevices, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="暂时没有已连接设备" Foreground="#C7CCDA" FontSize="12" />
                    <TextBlock Text="打开设备后，这里会自动刷新" Foreground="#6F778A" FontSize="10.5" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Button Content="打开主界面" Click="OpenMain_Click" Height="36" Margin="0,4,0,0"
                    Background="#7C5CFF" Foreground="White" BorderThickness="0" FontSize="12.5" FontWeight="SemiBold"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Border>
</Window>
